{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://track-production.service.kwift.eu/1.31.6/events/user/properties/click.json",
  "type": "object",
  "description": "Generic click event to be used with the browse block. Use this event to track clicks on generic button, as part of certain flows, when a dedicated event is not needed",
  "metas": {
    "area": "ui"
  },
  "properties": {
    "name": {
      "const": "click"
    },
    "button": {
      "$ref": "https://track-production.service.kwift.eu/1.31.6/definitions/properties/ui.json#/definitions/button"
    },
    "click_origin": {
      "$ref": "https://track-production.service.kwift.eu/1.31.6/definitions/properties/ui.json#/definitions/click_origin"
    }
  },
  "required": [
    "name",
    "button"
  ],
  "additionalProperties": false
}
