{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://track-production.service.kwift.eu/1.31.6/definitions/context/user.json",
  "type": "object",
  "description": "Definition for the user context",
  "definitions": {
    "id": {
      "description": "Server analytics user id : UUIDv4 - xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx (RFC4122)",
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9A-Fa-f]{8}-[0-9A-Fa-f]{4}-4[0-9A-Fa-f]{3}-[89ABab][0-9A-Fa-f]{3}-[0-9A-Fa-f]{12}$"
    },
    "user": {
      "description": "Definition for the user context",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "https://track-production.service.kwift.eu/1.31.6/definitions/context/user.json#/definitions/id"
        }
      },
      "required": [
        "id"
      ]
    }
  }
}
