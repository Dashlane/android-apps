{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://track-production.service.kwift.eu/1.31.6/definitions/properties/shared.json",
  "type": "object",
  "description": "Definitions for features",
  "definitions": {
    "flow_step": {
      "description": "the step in the current flow",
      "type": "string",
      "enum": [
        "cancel",
        "complete",
        "error",
        "start"
      ]
    },
    "mobile_browser_name": {
      "description": "Browser name of browser where this log has been triggered",
      "type": "string",
      "pattern": ".+"
    },
    "flow_type": {
      "description": "the type of flow. Can be an activation or deactivation flow",
      "type": "string",
      "enum": [
        "activation",
        "deactivation"
      ]
    },
    "domain_type": {
      "type": "string",
      "description": "either app or web",
      "enum": [
        "app",
        "web"
      ]
    },
    "invitation_link_click_origin": {
      "description": "The place on which the user has clicked the invitation link to join a B2B team",
      "type": "string",
      "enum": [
        "extension_mass_deployment",
        "invitation_email",
        "shared_invitation_link"
      ]
    },
    "domain_id": {
      "type": "string",
      "description": "Only use in anonymous events - SHA-256 hashed of if *web* : the top-domain for a URL. e.g: for https://app.facebook.com/login, it will be facebook.com hashed, so 31193328f8e21dfb6c99f322d22d7b0b508778e64ffbba86e52293379031b874. If *app* : application id / package name. eg: com.facebook.katana => 1191b6d2199790c5bad2b8c3d678c2aa41a23e2809ce7aa9fbec8778bc5c2973",
      "format": "sha256",
      "pattern": "^$|^[A-Fa-f0-9]{64}$"
    },
    "associated_websites_updated_list": {
      "description": "The list of associated domains to a credential that has been either added or removed by the user",
      "type": "array",
      "items": {
        "$ref": "https://track-production.service.kwift.eu/1.31.6/definitions/properties/shared.json#/definitions/domain_id"
      }
    },
    "associated_apps_updated_list": {
      "description": "The list of associated apps to a credential that has been either added or removed by the user",
      "type": "array",
      "items": {
        "$ref": "https://track-production.service.kwift.eu/1.31.6/definitions/properties/shared.json#/definitions/domain_id"
      }
    },
    "domain": {
      "type": "object",
      "description": "Only use in anonymous events - identifier of the url or the app.",
      "properties": {
        "type": {
          "$ref": "https://track-production.service.kwift.eu/1.31.6/definitions/properties/shared.json#/definitions/domain_type"
        },
        "id": {
          "$ref": "https://track-production.service.kwift.eu/1.31.6/definitions/properties/shared.json#/definitions/domain_id"
        }
      },
      "required": [
        "type"
      ],
      "additionalProperties": false
    },
    "help_center_article_cta": {
      "description": "Which Help Center CTA does the admin click on",
      "type": "string",
      "enum": [
        "contact_us",
        "explore_public_api_documentation",
        "get_antiphishing_tips",
        "get_help",
        "go_to_dashlane_support",
        "help_center",
        "learn_about_confidential_scim",
        "learn_about_confidential_sso",
        "learn_about_csv_import_formatting",
        "learn_about_dark_web_insights",
        "learn_about_domain_verification",
        "learn_about_mass_deployment",
        "learn_about_splunk_integration",
        "resource_center",
        "see_group_provisioning_setup_guide",
        "see_risk_detection_setup_guide",
        "see_splunk_setup_guide",
        "troubleshoot_importing_issues",
        "view_domain_verification_guide"
      ]
    },
    "is_native_app": {
      "description": "True if the action was performed inside a native app, rather than a Browser displaying a webpage",
      "type": "boolean"
    },
    "is_protected": {
      "type": "boolean",
      "description": "if the field is protected either by password/sso/fingerprint."
    },
    "is_set_as_default": {
      "type": "boolean",
      "description": "if the default settings in the generate password webcard or save/replace password webcard have been modified by the user."
    },
    "is_success": {
      "type": "boolean",
      "description": "indicates a success"
    },
    "is_first_launch": {
      "description": "True if the user launches the app for the first time. False if not.",
      "type": "boolean"
    },
    "cancel_plan_step": {
      "description": "The step in the cancel flow. Start when the cancel flow begins. Success_cancel when the subscription is cancelled and the user is out of policy for refund. Success_refund when the subscription is cancelled and refunded. Success_cancel_and_error_refund when the subscription is cancelled and refund does not go through because of an error. Contact_support when the user clicks on contact support after having an error with refund. Abandon when the user quits and does not complete the cancellation flow",
      "type": "string",
      "enum": [
        "abandon",
        "cancel_error",
        "contact_support",
        "selected_cancellation_reason",
        "start",
        "success_cancel",
        "success_cancel_and_error_refund",
        "success_refund"
      ]
    },
    "ms_to_completed_action_or_step": {
      "description": "Time taken by the user to complete action or step in milliseconds",
      "type": "integer"
    },
    "percentage_nb": {
      "description": "Percentage value measured between 0.0 and 1.0",
      "type": "number"
    },
    "plan": {
      "description": "The plans available at Dashlane",
      "type": "string",
      "enum": [
        "business",
        "business_plus",
        "essentials",
        "family",
        "free",
        "premium",
        "standard",
        "starter"
      ]
    },
    "payment_method": {
      "description": "The payment method chosen by the user to checkout from the Product",
      "type": "string",
      "enum": [
        "credit_card",
        "invoice"
      ]
    },
    "payment_status": {
      "description": "The status of the payment after a user attempted to checkout from the Product",
      "type": "string",
      "enum": [
        "assigned_plan_same_tier_as_current_plan",
        "b2b_plan_not_found",
        "cannot_invoice_free_plan",
        "change_tier_amount_too_expensive",
        "current_plan_start_date_in_future",
        "error_calculating_tier_change",
        "forbidden_email_domain",
        "insufficient_amount",
        "invalid_plan",
        "no_key_for_user",
        "not_billing_admin",
        "not_eligible_to_change_tier_mid_cycle",
        "not_in_a_team_plan",
        "not_in_free_trial",
        "not_team_captain",
        "payment_error_during_upgrade",
        "payment_mean_is_not_credit_card",
        "payment_mean_is_not_invoice",
        "sales_tax_mismatch",
        "seats_to_purchase_lower_actual_usage",
        "selected_plan_is_not_valid",
        "starter_plan_not_10_seats",
        "success",
        "team_has_sso_enabled",
        "unsupported_payment_mean",
        "user_subscribing_not_found",
        "vat_number_not_upserted",
        "wrong_amount_to_pay"
      ]
    },
    "plan_billing_period": {
      "description": "The billing period of the plan",
      "type": "string",
      "enum": [
        "monthly",
        "yearly"
      ]
    },
    "survey_answer": {
      "description": "The answer to the survey submitted by the user when canceling",
      "type": "string",
      "enum": [
        "autofill_didnt_work_as_expected",
        "dashlane_doesnt_have_the_features_i_need",
        "dashlane_is_too_expensive",
        "there_were_too_many_technical_issues"
      ]
    },
    "price_amount_cents": {
      "description": "Money in cents of currency spent",
      "type": "integer"
    },
    "purchased_seats_count": {
      "description": "Number of seats selected by the user when it validates its purchase order in the Product checkout",
      "type": "integer"
    },
