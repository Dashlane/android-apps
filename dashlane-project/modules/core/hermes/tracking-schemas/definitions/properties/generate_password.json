{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://track-production.service.kwift.eu/1.31.6/definitions/properties/generate_password.json",
  "type": "object",
  "description": "Definitions for credential details",
  "definitions": {
    "length": {
      "description": "Length of the password",
      "type": "integer"
    },
    "has_digits": {
      "description": "Whether the password has digits",
      "type": "boolean"
    },
    "has_letters": {
      "description": "Whether the password has letters",
      "type": "boolean"
    },
    "has_symbols": {
      "description": "Whether the password has symbols",
      "type": "boolean"
    },
    "has_similar": {
      "description": "Whether the password can contains chars considered as `similar`. Note: this is the opposite of the previous 'ambiguous characters` where we would avoid the `similar` one.",
      "type": "boolean"
    },
    "has_pwg_default_settings": {
      "description": "Whether the user has changed the default password generation settings or not.",
      "type": "boolean"
    }
  }
}
