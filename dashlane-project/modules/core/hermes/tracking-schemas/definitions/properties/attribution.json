{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://track-production.service.kwift.eu/1.31.6/definitions/properties/attribution.json",
  "type": "object",
  "description": "Definition for attribution parameters",
  "definitions": {
    "adid": {
      "description": "adjust device id, Identifying LAT users on iOS without idfa information",
      "type": "string",
      "pattern": "^.*$"
    },
    "android": {
      "type": "object",
      "description": "Android specific attribution parameters",
      "properties": {
        "adid": {
          "$ref": "https://track-production.service.kwift.eu/1.31.6/definitions/properties/attribution.json#/definitions/adid"
        },
        "advertising_id": {
          "$ref": "https://track-production.service.kwift.eu/1.31.6/definitions/properties/attribution.json#/definitions/advertising_id"
        },
        "android_id": {
          "$ref": "https://track-production.service.kwift.eu/1.31.6/definitions/properties/attribution.json#/definitions/android_id"
        }
      },
      "required": [
        "android_id"
      ],
      "additionalProperties": false
    },
    "android_id": {
      "description": "Android only - Android unique device ID. Lowercase, without hyphens",
      "type": "string",
      "pattern": "^.*$"
    },
    "gclid": {
      "description": "Google Click ID (GCLID). Google adwords tracking id. No format to enforce",
      "type": "string",
      "pattern": ".+"
    },
    "advertising_id": {
      "description": "Raw Google advertising ID. Lowercase, with hyphens",
      "type": "string",
      "pattern": "^.*$"
    },
    "heap_identity": {
      "description": "Identity of heap user",
      "type": "string",
      "pattern": "^.*$"
    },
    "has_cookie": {
      "description": "if the device has the web cookie to retrieve attribution information",
      "type": "boolean"
    },
    "idfa": {
      "description": "iOS only - Identifier for Advertisers (IDFA) is a random device identifier assigned by Apple to a user’s device. Uppercase, with hyphens",
      "type": "string",
      "pattern": "^.*$"
    },
    "idfv": {
      "description": "iOS only - Identifier for Advertisers (IDFA) is a random device identifier assigned by Apple to a user’s device. Uppercase, with hyphens",
      "type": "string",
      "pattern": "^.*$"
    },
