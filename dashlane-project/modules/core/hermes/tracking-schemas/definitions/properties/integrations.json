{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://track-production.service.kwift.eu/1.31.6/definitions/properties/integrations.json",
  "type": "object",
  "description": "Definition for Integrations events (e.g. Nudges)",
  "definitions": {
    "integration_platform": {
      "description": "The platform used in the integration.",
      "type": "string",
      "enum": [
        "dashlane_extension",
        "global",
        "in_context",
        "slack"
      ]
    },
    "nudge_action": {
      "description": "The action taken within the Nudges UI.",
      "type": "string",
      "enum": [
        "completed_setup",
        "see_in_context_nudge_example",
        "sent_test_nudge",
        "started_setup",
        "uninstalled_integration"
      ]
    },
    "nudge_type": {
      "description": "The type of nudge configured or sent.",
      "type": "string",
      "enum": [
        "adoption",
        "compromised_passwords",
        "passkey",
        "phishing",
        "reused_passwords",
        "weak_passwords"
      ]
    },
    "state": {
      "description": "The state of a toggle or setting within an integration.",
      "type": "string",
      "enum": [
        "off",
        "on"
      ]
    },
    "public_api_key_step": {
      "description": "Captures various steps in the Public API key creation flow.",
      "type": "string",
      "enum": [
        "copy_key",
        "create_key",
        "download_key",
        "generate_key",
        "key_generated",
        "key_generation_failed"
      ]
    }
  }
}
