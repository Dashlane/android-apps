# Define the openssl version
OPENSSL_VERSION=1.1.1b

# Define the architectures for Android application
# Different than openssl accepted architecture name
# Android       |       Openssl
# armeabi-v7a   |       android-arm
# arm64-v8a     |       android-arm64
# x86           |       android-x86
# x86_64        |       android-x86_64
architectures=("armeabi-v7a" "arm64-v8a" "x86" "x86_64")

# Define the required ndk version
required_ndk_version=19

# Set the minimum target Android API
target_api=21

# Define the current path as SCRIPTPATH
SCRIPTPATH=`realpath .`

OPENSSL_TARBALL=openssl-${OPENSSL_VERSION}.tar.gz
OPENSSL_DIR=openssl-${OPENSSL_VERSION}
OPENSSL_BUILD_LOG=${SCRIPTPATH}/temp/openssl-${OPENSSL_VERSION}.log