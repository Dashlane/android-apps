<?xml version="1.0" encoding="utf-8"?>
<resources>
    
    <string name="tips_change_password_title">How to create strong and memorable passwords</string>
    
    <string name="tips_change_password_section1_title">General rules</string>
    
    <string name="tips_change_password_section1_line1">• Avoid common sequences like “qwerty” or “12345”</string>
    
    <string name="tips_change_password_section1_line2">• Avoid personal information like birth dates or pet names</string>
    
    <string name="tips_change_password_section1_line3">• Aim for at least 10 characters</string>
    
    <string name="tips_change_password_section1_line4">• Avoid obvious substitutions (e.g. H0use)</string>
    
    <string name="tips_change_password_section2_title">The story method</string>
    
    <string name="tips_change_password_section2_desc">Create a story about an interesting person in an interesting place.</string>
    
    <string name="tips_change_password_section2_example">momwenttoEverestinwinter</string>
    
    <string name="tips_change_password_section3_title">The series of words method</string>
    
    <string name="tips_change_password_section3_desc">Choose a series of words that don’t make grammatical sense together.</string>
    
    <string name="tips_change_password_section3_example">WinterMomEverestWent</string>
    
    <string name="tips_change_password_section4_title">The main letters and numbers method</string>
    
    <string name="tips_change_password_section4_desc">Use the main characters from a story unique to you. For example, “&lt;em&gt;&lt;strong&gt;T&lt;/strong&gt;he &lt;strong&gt;f&lt;/strong&gt;irst &lt;strong&gt;a&lt;/strong&gt;partment &lt;strong&gt;I&lt;/strong&gt; &lt;strong&gt;e&lt;/strong&gt;ver &lt;strong&gt;l&lt;/strong&gt;ived &lt;strong&gt;i&lt;/strong&gt;n &lt;strong&gt;w&lt;/strong&gt;as &lt;strong&gt;613&lt;/strong&gt; &lt;strong&gt;G&lt;/strong&gt;rove &lt;strong&gt;S&lt;/strong&gt;treet. &lt;strong&gt;R&lt;/strong&gt;ent &lt;strong&gt;w&lt;/strong&gt;as &lt;strong&gt;$5&lt;/strong&gt;00 &lt;strong&gt;p&lt;/strong&gt;er &lt;strong&gt;m&lt;/strong&gt;onth&lt;/em&gt;”</string>
    
    <string name="tips_change_password_section4_example">TfaIeliw613GS.Rw$5pm</string>
    
    <string name="tips_change_password_activity_label">Password tips</string>
</resources>
